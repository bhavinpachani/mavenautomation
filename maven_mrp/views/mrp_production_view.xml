<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_inherit_update_bom" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.update.bom</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Example: add button inside header -->
            <xpath expr="//header" position="inside">
                <button name="action_update_bom"
                    type="object"
                    string="Update BOM"
                    class="btn-primary"
                    invisible="state != 'done' or bom_updated"/>
            </xpath>

        </field>
    </record>

</odoo>