<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_view_inherit_update_bom" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.update.bom</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Example: add button inside header -->
            <xpath expr="//header" position="inside">
                <button name="action_update_bom"
                    type="object"
                    string="Update BOM"
                    class="btn-primary"
                    invisible="state != 'done' or bom_updated"/>
            </xpath>

        </field>
    </record>

    <record id="product_template_form_view_mrp_ok_name" model="ir.ui.view">
        <field name="name">product.template.form.mrp.ok.name</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">mrp_ok</attribute>
                <attribute name="placeholder">Auto-assigned on save: WO/YY-YY/XXXX</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_mrp_ok_checkbox" model="ir.ui.view">
        <field name="name">product.template.form.mrp.ok.checkbox</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']//span[field[@name='purchase_ok']]" position="after">
                <span class="d-inline-flex" invisible="type == 'combo' or not mrp_ok">
                    <field name="mrp_ok" readonly="1" force_save="1"/>
                    <label for="mrp_ok" string="Panel Create"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_mrp_ok" model="ir.ui.view">
        <field name="name">product.template.search.mrp.ok</field>
        <field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
                <xpath expr="//filter[@name='filter_to_purchase']" position="after">
                <filter string="Panel Create" name="filter_to_mrp" domain="[('mrp_ok', '=', True)]"/>
            </xpath>
        </field>
    </record>
    <record id="mrp.product_template_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="path">manufacturing-products</field>
        <field name="search_view_id" ref="mrp.mrp_product_template_search_view"/>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{
            "search_default_filter_to_mrp": 1,
            "search_default_goods": 1,
            "default_is_storable": True,
            "default_mrp_ok": True
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No product found. Let's create one!</p>
            <p>Define the components and finished products you wish to use in bill of materials and manufacturing orders.</p>
        </field>
    </record>

    <menuitem id="mrp.menu_mrp_product_form"
            name="Panel Create"
            action="mrp.product_template_action"
            parent="mrp.menu_mrp_bom" sequence="1"/>
</odoo>