<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_standalone_delivery" model="ir.ui.view">
        <field name="name">account.move.form.standalone.delivery</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="sale_order_count" invisible="1"/>
                <field name="standalone_picking_ids"
                       widget="many2many_tags"
                       options="{'no_create': True, 'no_create_edit': True}"
                       invisible="move_type != 'out_invoice' or sale_order_count &gt; 0 or not partner_id"
                       readonly="state == 'cancel'"/>
            </xpath>
        </field>
    </record>

</odoo>
