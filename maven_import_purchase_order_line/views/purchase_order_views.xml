<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_import_pol" model="ir.ui.view">
        <field name="name">purchase.order.form.import.pol</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(maven_import_purchase_order_line.action_import_purchase_order_line_wizard)d"
                        type="action"
                        string="Import POL"
                        class="btn-secondary"
                        invisible="state != 'draft' or not id"
                        context="{'default_purchase_order_id': id}"/>
            </xpath>
        </field>
    </record>

</odoo>
