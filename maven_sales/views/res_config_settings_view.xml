<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_custom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//setting[@id='quotation_validity_days']" position="after">

                <block title="Validate Customer Information Before Sale" name="validate_customer_information">

                    <setting id="validate_so_vat_setting"
                             string="VAT">
                        <field name="validate_so_vat"/>
                    </setting>

                    <setting id="validate_so_email_setting"
                             string="Email">
                        <field name="validate_so_email"/>
                    </setting>

                    <setting id="validate_so_mobile_setting"
                             string="Mobile">
                        <field name="validate_so_mobile"/>
                    </setting>

                    <setting id="validate_so_payment_term_setting"
                             string="Payment Term">
                        <field name="validate_so_payment_term"/>
                    </setting>

                    <setting id="validate_so_salesman_setting"
                             string="Salesman">
                        <field name="validate_so_salesman"/>
                    </setting>

                    <setting id="validate_so_address_setting"
                             string="Address">
                        <field name="validate_so_address"/>
                    </setting>

                    <setting id="validate_so_delivery_setting"
                             string="Delivery Method">
                        <field name="validate_so_delivery"/>
                    </setting>

                    <setting id="validate_so_po_setting"
                             string="PO Number">
                        <field name="validate_so_po"/>
                    </setting>

                    <setting id="validate_so_industry_setting"
                             string="Contact Type">
                        <field name="validate_so_industry_id"/>
                    </setting>

                </block>

            </xpath>

        </field>
    </record>

</odoo>