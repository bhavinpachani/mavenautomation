<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_contact_read_only_access" model="res.groups">
            <field name="name">Contact Read-Only Access</field>
        </record>

        <!-- Shown in the user form under Accounting, after Bank (sequence 50). -->
        <record id="privilege_customer_menu" model="res.groups.privilege">
            <field name="name">Customer Menu</field>
            <field name="sequence">60</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="description">Show the Customers menu in Invoicing.</field>
        </record>
        <record id="group_customer_menu_access" model="res.groups">
            <field name="name">Customer Menu</field>
            <field name="privilege_id" ref="privilege_customer_menu"/>
            <field name="comment">Users with this right can see the Customers menu in Invoicing.</field>
        </record>

        <record id="privilege_vendor_menu" model="res.groups.privilege">
            <field name="name">Vendor Menu</field>
            <field name="sequence">70</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="description">Show the Vendors menu in Invoicing.</field>
        </record>
        <record id="group_vendor_menu_access" model="res.groups">
            <field name="name">Vendor Menu</field>
            <field name="privilege_id" ref="privilege_vendor_menu"/>
            <field name="comment">Users with this right can see the Vendors menu in Invoicing.</field>
        </record>

        <record id="account.menu_finance_receivables" model="ir.ui.menu">
            <field name="group_ids" eval="[(4, ref('group_customer_menu_access'))]"/>
        </record>
        <record id="account.menu_finance_payables" model="ir.ui.menu">
            <field name="group_ids" eval="[(4, ref('group_vendor_menu_access'))]"/>
        </record>
    </data>
</odoo>
