<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_view_from_inherit_make_readonly" model="ir.ui.view">
        <field name="name">stock.picking.view.from.inherit.make.readonly</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">sale_id != False</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <!--<xpath expr="//field[@name='scheduled_date']" position="attributes">
                <attribute name="readonly">sale_id != False</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>-->
            <xpath expr="//header/button[@name='action_confirm']" position="attributes">
                <attribute name="invisible">sale_id != False</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="groups">bista_access_rights.group_picking_return_cancel_access</attribute>
            </xpath>
            <xpath expr="//header/button[@name='421']" position="attributes">
                <attribute name="groups">bista_access_rights.group_picking_return_cancel_access</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="attributes">
                <attribute name="readonly">sale_id != False</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='move_type']" position="attributes">
                <attribute name="readonly">sale_id != False</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="readonly">sale_id != False</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="readonly">sale_id != False</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']" position="attributes">
                <attribute name="readonly">(state == 'done' and is_locked) or sale_id != False</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='origin']" position="attributes">
                <attribute name="readonly">sale_id != False</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_inherit_project_stock_make_readonly" model="ir.ui.view">
        <field name="name">view.picking.form.inherit.project.stock.make.readonly</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="project_stock.view_picking_form_inherit_project_stock" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="readonly">sale_id != False</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_sale_stock_sale_id" model="ir.ui.view">
        <field name="name">view.picking.form.sale.stock.sale.id</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="sale_stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
