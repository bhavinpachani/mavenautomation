<odoo>
     <record id="view_account_journal_inherit_allowed_users" model="ir.ui.view">
        <field name="name">view.account.journal.inherit.allowed.users</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='autocheck_on_post']"
                   position="after">
                <field name="allow_user_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                <field name="user_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}" invisible="1"/>
            </xpath>
        </field>
     </record>
</odoo>