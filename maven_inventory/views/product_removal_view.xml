<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View Inherit -->
    <record id="view_product_removal_form_add_fields" model="ir.ui.view">
        <field name="name">product.removal.form.add.fields</field>
        <field name="model">product.removal</field>
        <field name="inherit_id" ref="stock.view_removal"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='method']" position="after">
                <field name="is_default" readonly="0"/>
            </xpath>
        </field>
    </record>


</odoo>
