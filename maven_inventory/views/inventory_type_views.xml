<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_inventory_type_tree" model="ir.ui.view">
        <field name="name">inventory.type.tree</field>
        <field name="model">inventory.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_inventory_type_form" model="ir.ui.view">
        <field name="name">inventory.type.form</field>
        <field name="model">inventory.type</field>
        <field name="arch" type="xml">
            <form string="Inventory Type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_inventory_type" model="ir.actions.act_window">
        <field name="name">Make</field>
        <field name="res_model">inventory.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem
        id="menu_inventory_type"
        name="Make"
        parent="stock.menu_warehouse_config"
        action="action_inventory_type"
        sequence="6"
        groups="purchase.group_purchase_manager"
    />
</odoo>
