<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_purchaseorder_roundoff"
              inherit_id="purchase.report_purchaseorder_document">

        <!-- Add Round Off Amount and Rounded Total after the Total section -->
        <xpath expr="//div[@id='total']" position="after">

            <div class="row justify-content-end">
                <div class="col-4">
                    <table class="o_total_table table table-borderless mb-0">
                        <!-- Double-line separator after Total -->
                        <tr>
                            <td colspan="2"
                                style="border-top: 3px double #000; padding: 0; line-height: 0;">
                            </td>
                        </tr>

                        <!-- Round Off Amount row -->
                        <tr>
                            <td class="py-1">
                                <span>Round Off Amount</span>
                            </td>
                            <td class="text-end py-1">
                                <span t-field="o.amount_round_off"/>
                            </td>
                        </tr>

                        <!-- Rounded Total row (bold) -->
                        <tr>
                            <td class="py-1">
                                <strong>Rounded Total</strong>
                            </td>
                            <td class="text-end py-1">
                                <span t-field="o.po_amount_round_off_total"
                                      class="fw-bold"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>

        </xpath>

    </template>

</odoo>
