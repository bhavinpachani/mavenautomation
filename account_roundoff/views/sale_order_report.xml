<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="report_saleorder_roundoff"
              inherit_id="sale.report_saleorder_document">

        <!-- Add Round Off Amount and Rounded Total below the Total line -->
        <xpath expr="//div[@id='total']//t[@t-call='sale.document_tax_totals']"
               position="after">

            <t t-if="doc.amount_round_off_total">
                <!-- Double-line separator after Total -->
                <tr>
                    <td colspan="2" style="border-top: 3px double #000; padding: 0; line-height: 0;">
                    </td>
                </tr>

                <!-- Round Off Amount row -->
                <tr>
                    <td class="py-1">
                        <span>Round Off Amount</span>
                    </td>
                    <td class="text-end py-1">
                        <span t-field="doc.amount_round_off"/>
                    </td>
                </tr>

                <!-- Rounded Total row (bold) -->
                <tr>
                    <td class="py-1">
                        <strong>Rounded Total</strong>
                    </td>
                    <td class="text-end py-1">
                        <span t-field="doc.amount_round_off_total"
                              class="fw-bold"/>
                    </td>
                </tr>
            </t>

        </xpath>

    </template>

</odoo>
