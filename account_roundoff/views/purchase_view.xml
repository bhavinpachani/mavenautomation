<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="purchase_order_round_off" model="ir.ui.view">
            <field name="name">purchase.order.round.off</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Hidden config field -->
                <field name="origin" position="after">
                    <field name="is_enabled_roundoff" invisible="1"/>
                </field>
                <xpath expr="//group[@class='oe_subtotal_footer']/parent::group" position="after">
                    <div class="d-flex flex-column align-items-end mt-2">
                        <table class="w-auto">
                            <tr>
                                <td class="text-end text-muted pe-3 py-1">Round Off Amount</td>
                                <td class="text-end py-1">
                                    <field name="amount_round_off" widget="monetary" readonly="1" force_save="1"
                                           nolabel="1"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-end pe-3 py-1">
                                    <strong>Rounded Total</strong>
                                </td>
                                <td class="text-end py-1">
                                    <field name="po_amount_round_off_total" widget="monetary" readonly="1"
                                           force_save="1" nolabel="1" class="fw-bold"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>