<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="round_off_config" model="ir.ui.view">
            <field name="name">res.config.settings.roundoff</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//app[@name='account']" position="inside">

                    <block title="Round Off"
                           name="account_roundoff_settings"
                           groups="account.group_account_manager">

                        <setting string="Invoice Round Off"
                                 help="Allow rounding of the total invoice amount to the nearest whole number.">

                            <field name="invoice_roundoff"/>

                            <div class="content-group"
                                 invisible="not invoice_roundoff">

                                <div class="mt-2">
                                    <label for="roundoff_account_id"
                                           class="o_light_label"/>

                                    <field name="roundoff_account_id"
                                           required="invoice_roundoff"/>
                                </div>

                            </div>

                        </setting>

                    </block>

                </xpath>

            </field>
        </record>

    </data>
</odoo>