<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="maven_purchase_config_setting_form_inherit" model="ir.ui.view">
        <field name="name">maven.purchase.config.form.inherited</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">

            <xpath expr="//app[@name='purchase']" position="inside">

                <block title="Validate Vendor Information Before Purchase"
                       name="validate_vendor_information">

                    <setting id="validate_po_vat_setting" string="VAT">
                        <field name="validate_po_vat"/>
                    </setting>

                    <setting id="validate_po_email_setting" string="Email">
                        <field name="validate_po_email"/>
                    </setting>

                    <setting id="validate_po_mobile_setting" string="Mobile">
                        <field name="validate_po_mobile"/>
                    </setting>

                    <setting id="validate_po_payment_term_setting" string="Payment Term">
                        <field name="validate_po_payment_term"/>
                    </setting>

                    <setting id="validate_po_address_setting" string="Address">
                        <field name="validate_po_address"/>
                    </setting>

                    <setting id="validate_po_tag_setting" string="Deal In">
                        <field name="validate_po_tag"/>
                    </setting>

                    <setting id="validate_po_industry_setting" string="Contact Type">
                        <field name="validate_po_industry_id"/>
                    </setting>

                </block>

            </xpath>

        </field>
    </record>

</odoo>