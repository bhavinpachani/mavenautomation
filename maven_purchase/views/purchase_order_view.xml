<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_add_fields" model="ir.ui.view">
        <field name="name">view_purchase_order_add_fields</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- Insert discount before subtotal -->
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="show_discount" string="Show Discount"/>
            </xpath>

            <xpath expr="//notebook/page[@name='products']/field[@name='order_line']//list/field[@name='product_uom_id']" position="after">
                <xpath expr="//notebook/page[@name='products']/field[@name='order_line']//list/field[@name='date_planned']" position="move"/>
            </xpath>

            <xpath expr="//notebook/page[@name='products']/field[@name='order_line']//list/field[@name='discount']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//notebook/page[@name='products']/field[@name='order_line']//list/field[@name='discount']" position="after">
                <field name="unit_rate"/>
            </xpath>

            <xpath expr="//notebook/page[@name='products']/field[@name='order_line']//list/field[@name='price_subtotal']" position="after">
                <xpath expr="//notebook/page[@name='products']/field[@name='order_line']//list/field[@name='tax_ids']" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>