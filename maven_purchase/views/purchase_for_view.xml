<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_for_tree" model="ir.ui.view">
        <field name="name">purchase.for.tree</field>
        <field name="model">purchase.for</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_for_form" model="ir.ui.view">
        <field name="name">purchase.for.form</field>
        <field name="model">purchase.for</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_purchase_for" model="ir.actions.act_window">
        <field name="name">Purchase For</field>
        <field name="res_model">purchase.for</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_purchase_for"
          name="Purchase For"
          parent="purchase.menu_purchase_config"
          action="action_purchase_for"
          sequence="50"/>
</odoo>
