<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">

        <!-- Remove Expected Arrival from Header -->
        <xpath expr="//div[@id='informations']/div[@t-if='o.date_planned']" position="replace"/>
        
        <!-- Calculate product sums and select first lines to display -->
        <xpath expr="//tbody" position="before">
            <t t-set="seq_number" t-value="0"/>
            <t t-set="product_sums" t-value="{}"/>
            <!-- Use list to maintain order -->
            <t t-set="lines_to_show" t-value="[]"/>
            <t t-foreach="o.order_line" t-as="l">
                <t t-if="l.product_id">
                    <t t-set="pid" t-value="l.product_id.id"/>
                    <t t-if="pid not in product_sums">
                        <t t-set="dummy" t-value="product_sums.update({pid: l.product_qty})"/>
                        <t t-set="dummy" t-value="lines_to_show.append(l.id)"/>
                    </t>
                    <t t-else="">
                        <t t-set="dummy" t-value="product_sums.update({pid: product_sums[pid] + l.product_qty})"/>
                    </t>
                </t>
                <t t-else="">
                    <t t-set="dummy" t-value="lines_to_show.append(l.id)"/>
                </t>
            </t>
        </xpath>

        <!-- Ensure duplicate product rows do not render -->
        <xpath expr="//td[@id='product']/.." position="attributes">
            <attribute name="t-if">line.id in lines_to_show</attribute>
        </xpath>

        <!-- Sequence Header -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_sequence" class="text-center"><strong>Sr. No.</strong></th>
        </xpath>

        <!-- Sequence Column Data -->
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_sequence" class="text-center">
                <t t-set="seq_number" t-value="seq_number + 1"/>
                <span t-out="seq_number"/>
            </td>
        </xpath>

        <!-- Expected Date Header -->
        <xpath expr="//th[@name='th_price_unit']" position="before">
            <th name="th_date_planned" class="text-start"><strong>Expected Date</strong></th>
        </xpath>

        <!-- Expected Date Data -->
        <xpath expr="//td[span[@t-field='line.price_unit']]" position="before">
            <td name="td_date_planned" class="text-start">
                <span t-field="line.date_planned" t-options='{"widget": "date"}'/>
            </td>
        </xpath>

        <!-- Unit Rate Header after Discount -->
        <xpath expr="//th[@name='th_discount']" position="after">
            <th name="th_unit_rate" class="text-end"><strong>Unit Rate</strong></th>
        </xpath>

        <!-- Unit Rate Data after Discount -->
        <xpath expr="//td[descendant::span[@t-field='line.discount']]" position="after">
            <td name="td_unit_rate" class="text-end">
                <span t-field="line.unit_rate"/>
            </td>
        </xpath>

        <!-- Change Amount header to Subtotal -->
        <xpath expr="//th[@name='th_subtotal']" position="replace">
            <th name="th_subtotal" class="text-end"><strong>Subtotal</strong></th>
        </xpath>

        <!-- Move Tax Header after Amount/Subtotal -->
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//th[@name='th_subtotal']" position="after">
            <th name="th_taxes" class="text-end"><strong>Taxes</strong></th>
        </xpath>

        <!-- Move Tax Data after Amount/Subtotal -->
        <!-- Replace the old tax cell which is exactly the preceding sibling to the subtotal cell -->
        <xpath expr="//td[span[@t-field='line.price_subtotal']]/preceding-sibling::td[1]" position="replace"/>
        
        <!-- Insert the new tax cell after the subtotal cell -->
        <xpath expr="//td[span[@t-field='line.price_subtotal']]" position="after">
            <td name="td_taxes" class="text-end">
                <span t-out="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
            </td>
        </xpath>

        <!-- Conditional Visibility: Hide Unit Price Header and Data if o.show_discount == True -->
        <xpath expr="//th[@name='th_price_unit']" position="attributes">
            <attribute name="t-if">o.show_discount</attribute>
        </xpath>
        <xpath expr="//td[span[@t-field='line.price_unit']]" position="attributes">
            <attribute name="t-if">o.show_discount</attribute>
        </xpath>

        <!-- Conditional Visibility: Hide Discount Header and Data if o.show_discount == True -->
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="t-if">o.show_discount</attribute>
        </xpath>
        <xpath expr="//td[descendant::span[@t-field='line.discount']]" position="attributes">
            <attribute name="t-if">o.show_discount</attribute>
        </xpath>

        <!-- Replace Quantity with calculated sum -->
        <xpath expr="//span[@t-field='line.product_qty']" position="replace">
            <t t-if="line.product_id">
                <span t-out="product_sums[line.product_id.id]"/>
            </t>
            <t t-else="">
                <span t-field="line.product_qty"/>
            </t>
        </xpath>

        <!-- Replace Subtotal with calculated Subtotal for the merged quantity -->
        <xpath expr="//span[@t-field='line.price_subtotal']" position="replace">
            <t t-if="line.product_id">
                <t t-set="calc_qty" t-value="product_sums[line.product_id.id]"/>
                <t t-set="price" t-value="line.price_unit * (1 - (line.discount or 0.0) / 100.0)"/>
                <t t-set="taxes_res" t-value="line.tax_ids.compute_all(price, line.order_id.currency_id, calc_qty, product=line.product_id, partner=line.order_id.partner_id)"/>
                <span t-out="taxes_res['total_excluded']" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </t>
            <t t-else="">
                <span t-field="line.price_subtotal"/>
            </t>
        </xpath>

        <!-- Format Description to bold default_code -->
        <xpath expr="//td[@id='product']/span[@t-field='line.name']" position="replace">
            <t t-if="line.product_id">
                <t t-if="line.product_id.default_code">
                    <strong>[<span t-out="line.product_id.default_code"/>]</strong> <span t-out="line.product_id.name"/>
                </t>
                <t t-else="">
                    <span t-out="line.product_id.name"/>
                </t>
            </t>
            <t t-else="">
                <span t-field="line.name"/>
            </t>
        </xpath>

    </template>
</odoo>