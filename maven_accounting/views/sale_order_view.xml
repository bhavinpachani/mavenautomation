<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_searchable_tax" model="ir.ui.view">
        <field name="name">sale.order.form.searchable.tax</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form//field[@name='tax_ids']" position="attributes">
                <attribute name="domain">[('type_tax_use', '=', 'sale'), ('country_id', '=', tax_country_id), ('is_searchable', '=', True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="attributes">
                <attribute name="domain">[('type_tax_use', '=', 'sale'), ('country_id', '=', tax_country_id), ('is_searchable', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_view_form_searchable_tax" model="ir.ui.view">
        <field name="name">sale.order.line.form.searchable.tax</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_ids']" position="attributes">
                <attribute name="domain">[('type_tax_use', '=', 'sale'), ('company_id', '=', company_id), ('country_id', '=', tax_country_id), ('is_searchable', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

</odoo>
