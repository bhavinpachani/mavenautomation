<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_add_fields" model="ir.ui.view">
        <field name="name">view.move.form.add.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_reference']" position="replace"/>

            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="required">move_type in ('in_invoice', 'out_invoice', 'in_refund', 'out_refund', 'in_receipt')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="attributes">
                <attribute name="required">move_type in ('out_invoice')</attribute>
            </xpath>
            <!-- Add after discount field in invoice lines -->
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='discount']" position="after">
                <field name="unit_rate"/>
            </xpath>
            <xpath expr="//field[@name='invoice_date']" position="after">

                <!-- Payment Reference -->
                <field name="payment_reference"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                       readonly="inalterable_hash != False"
                       placeholder="Use Bill Reference"/>

            </xpath>

        </field>
    </record>

</odoo>
