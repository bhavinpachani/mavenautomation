<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_sale_order_line_wizard_form" model="ir.ui.view">
        <field name="name">import.sale.order.line.wizard.form</field>
        <field name="model">import.sale.order.line.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Sale Order Lines">
                <group>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="file" filename="file_name" options="{'accepted_file_extensions': '.xls,.xlsx,.csv'}"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <group invisible="not import_message">
                    <field name="import_message" nolabel="1" colspan="2"/>
                    <field name="not_imported_file" filename="not_imported_filename"
                            invisible="not not_imported_file"/>
                    <field name="not_imported_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"
                            invisible="not file"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_sale_order_line_wizard" model="ir.actions.act_window">
        <field name="name">Import SOL</field>
        <field name="res_model">import.sale.order.line.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_sale_order_id': active_id}</field>
    </record>

</odoo>
